# ============ Worldview Archive 后端配置 ============
# 复制本文件为 .env，然后填入真实信息

# ---- 服务端口 ----
PORT=3000
# API 允许跨域（多前端调试用，留空即同源）
CORS_ORIGIN=

# ---- 数据存储 ----
# 用 JSON 文件存用户/验证码/投稿；留空则用内存
DATA_DIR=./data
# 档案数据（anomalies/organizations 等 JSON）所在目录，相对项目根
ARCHIVE_DATA_DIR=../data
# DOCX 解析出的图片存到哪里（相对项目根，前端通过 /data/uploads 访问）
UPLOAD_DIR=../data/uploads

# ---- 管理员 ----
# 管理员联系键（手机号或邮箱，必须是字符串，留空则用内置 admin）
ADMIN_CONTACT=admin
# 管理员初始密码（留空默认 admin123，请务必修改）
ADMIN_PASS=admin123
# JWT 签名密钥（一定要改！）
JWT_SECRET=please-change-this-secret-to-a-long-random-string

# ---- 短信通道：mock / aliyun ----
SMS_PROVIDER=mock
# SMS_PROVIDER=aliyun

# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
# 在 https://dysms.console.aliyun.com/ 开通后获取
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=          # 短信签名，如：世界观察档案室
ALIYUN_SMS_TEMPLATE_CODE=     # 模板CODE，如：SMS_123456789
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---- 邮件通道：mock / smtp ----
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=smtp

# SMTP 邮件（EMAIL_PROVIDER=smtp 时必填）
SMTP_HOST=smtp.qq.com          # qq=smtp.qq.com, 163=smtp.163.com, gmail=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=                     # 邮箱授权码（不是登录密码）
EMAIL_FROM_NAME="世界观察档案室"

# ---- 安全 ----
# 验证码有效期（秒）
CODE_TTL_SEC=300
# 同一手机号/邮箱发送频率限制（秒）
SEND_COOLDOWN_SEC=60
# 同一 IP 每日发送上限
DAILY_LIMIT_PER_IP=100
# 注册后默认等级
DEFAULT_LEVEL=LV.2
